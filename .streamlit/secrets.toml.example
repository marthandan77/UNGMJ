# Copy this file to .streamlit/secrets.toml locally, or enter the same
# keys in Streamlit Community Cloud under App settings > Secrets.
# Never commit the real secrets.toml file.

[data]
# Change this value without editing GitHub files.
# Supported: "twelvedata", "schwab", "yfinance"
provider = "twelvedata"

[twelvedata]
api_key = "YOUR_TWELVE_DATA_API_KEY"
base_url = "https://api.twelvedata.com"

[schwab]
client_id = "YOUR_SCHWAB_CLIENT_ID"
client_secret = "YOUR_SCHWAB_CLIENT_SECRET"
access_token = ""
refresh_token = ""
token_url = "https://api.schwabapi.com/v1/oauth/token"
market_data_base_url = "https://api.schwabapi.com/marketdata/v1"
